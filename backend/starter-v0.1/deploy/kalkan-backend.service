[Unit]
Description=KALKAN-1 lab backend
After=network.target

[Service]
Type=simple
User=kalkan
Group=kalkan
WorkingDirectory=/opt/kalkan-1-backend
Environment=KALKAN_HOST=127.0.0.1
Environment=KALKAN_PORT=8088
Environment=KALKAN_RUNTIME=/var/lib/kalkan-1-backend
Environment=KALKAN_LOG_PATH=/var/log/kalkan-1-backend/events.jsonl
ExecStart=/usr/bin/python3 /opt/kalkan-1-backend/server.py
Restart=on-failure
RestartSec=3
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/kalkan-1-backend /var/log/kalkan-1-backend

[Install]
WantedBy=multi-user.target
